# macOS / filesystem noise
.DS_Store
**/.DS_Store

# Nested repos and vendored deps
**/.git/
**/node_modules/

# --- Local editor/agent state ---------------------------------------------
.pi/
**/.claude/
**/.zed/
zed/keymap.json.bak

# --- GUI app config dirs: keep settings, drop internals --------------------
# These apps store binaries, caches, session state and update payloads in
# ~/.config. Only the hand-edited settings files are worth backing up.
1Password/**
!1Password/README.md

billion-context/**
!billion-context/billion-context.json

herdr-app/**
!herdr-app/settings.json
!herdr-app/view.json
!herdr-app/AGENTS.md

magpie/**
!magpie/settings.json

omniwm/**
!omniwm/shell/shell.toml

# --- Caches, logs, runtime state ------------------------------------------
**/*.log
**/.cache/
zsh/.zcompcache/
zsh/.zcompdump
zsh/.zcompdump.*
zsh/.zsh_history
zsh/.zim/

# --- Machine-local overrides ----------------------------------------------
**/*.local.*
