// Zed settings — https://zed.dev/docs/configuring-zed
{
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },

  // --- Editor look & feel -------------------------------------------------
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrainsMono NF",
  "buffer_font_fallbacks": ["Menlo", "monospace"],
  "buffer_line_height": "comfortable",
  "show_whitespaces": "selection",
  "show_wrap_guides": true,
  "soft_wrap": "none",
  "cursor_blink": true,
  "scrollbar": { "show": "auto" },
  "relative_line_numbers": "disabled",
  "indent_guides": { "enabled": true },

  // --- Editing behaviour --------------------------------------------------
  "tab_size": 2,
  "hard_tabs": false,
  "autosave": { "after_delay": { "milliseconds": 1000 } },
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "trim_trailing_whitespace_on_save": true,
  "trim_automatic_whitespace": true,
  "use_autoclose": true,
  "use_smartcase_search": true,
  "use_system_clipboard": "always",
  "confirm_quit": false,
  "vim_mode": false,
  "scroll_beyond_last_line": "one_page",

  // --- Files --------------------------------------------------------------
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.project",
    "**/.settings",
    "**/out",
    "**/target",
    "**/build",
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
    "**/.next",
    "**/.turbo",
    "**/dist"
  ],
  "private_files": ["**/.env", "**/.env.*", "**/secrets/**"],
  "show_hidden_files_in_project_panel": false,

  // --- Git ----------------------------------------------------------------
  "git": {
    "inline_blame": { "enabled": true, "delay_ms": 500 },
    "git_gutter": "tracked_files",
    "hunk_style": "staged_hollow"
  },
  "git_panel": { "dock": "right" },

  // --- Terminal -----------------------------------------------------------
  "terminal": {
    "font_size": 13,
    "font_family": "JetBrainsMono NF",
    "shell": { "program": "zsh" },
    "copy_on_select": true,
    "working_directory": "current_project_directory",
    "button": true
  },

  // --- LSP / diagnostics --------------------------------------------------
  "diagnostics": { "include_warnings": true, "inline": { "enabled": true } },
  "inlay_hints": { "enabled": true, "show_type_hints": true, "show_parameter_hints": true },
  "hover_popover_enabled": true,
  "auto_update": true,

  // --- Per-language overrides --------------------------------------------
  "languages": {
    "Python": { "tab_size": 4, "language_servers": ["pyright", "ruff"] },
    "Rust": { "tab_size": 4 },
    "Go": { "hard_tabs": true },
    "Makefile": { "hard_tabs": true },
    "Markdown": { "soft_wrap": "preferred_line_length", "format_on_save": "off" },
    "YAML": { "tab_size": 2 }
  }
}
